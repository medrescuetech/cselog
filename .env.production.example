# Production Environment Configuration Template
# Upload this to ~/csem-app/.env (OUTSIDE the repository and public_html)
# Run `php artisan key:generate --show` and paste the generated key into APP_KEY.

APP_NAME="CSEM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://csem.yourdomain.com.au

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
CSEM_ERROR_LOG_LEVEL=warning

# Database Configuration (cPanel MySQL or Managed Database)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_csem
DB_USERNAME=cpaneluser_csem
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Drivers (Database sessions & queues; file or database cache)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=file

# Mail Settings (Optional - for notifications/alerts)
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=mail.yourdomain.com.au
# MAIL_PORT=587
# MAIL_USERNAME=alerts@yourdomain.com.au
# MAIL_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com.au"
MAIL_FROM_NAME="${APP_NAME}"

# CSEM Application Thresholds & Admin Seeding
# IMPORTANT: Provide strong admin credentials before running migrations / seeders
CSEM_ADMIN_EMAIL=admin@yourdomain.com.au
CSEM_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
CSEM_AMBER_HOURS=2
CSEM_RED_HOURS=4
