APP_NAME="HWRT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Australia/Perth

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
HWRT_ERROR_LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hwrt
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hwrt@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# HWRT bootstrap admin
HWRT_ADMIN_NAME="Admin"
HWRT_ADMIN_USERNAME=admin
HWRT_ADMIN_EMAIL=
HWRT_ADMIN_PASSWORD=changeme

HWRT_AMBER_HOURS=2
HWRT_RED_HOURS=4
HWRT_POLL_SECONDS=15
HWRT_ALLOW_EXTERNAL_ASSETS=true

# Production/cPanel map runtime (recommended):
# HWRT_SITEMAP_PATH=/absolute/path/to/app/storage/app/hwrt-sitemap
# HWRT_SITEMAP_URL=/sitemap
