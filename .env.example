# Copy to .env and edit. Never commit .env.
APP_NAME="CSE Log"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Australia/Brisbane
SITE_NAME="Main Site"
# Set true when the site is served over HTTPS behind a proxy that does not
# forward HTTPS/X-Forwarded-Proto (pins the Secure flag on session cookies).
FORCE_HTTPS=false

# sqlite (local dev, small single-site installs) or mysql (cPanel)
DB_CONNECTION=sqlite

# sqlite: absolute or relative path to the database file
DB_DATABASE=storage/cselog.sqlite

# mysql: set DB_CONNECTION=mysql and fill these in from cPanel
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=

# Board escalation: an open entry turns amber then red after this many hours.
ALERT_AMBER_HOURS=2
ALERT_RED_HOURS=4

# Duplicate-location warning radius, in map pixels.
DUPLICATE_RADIUS_PX=60

# Seconds between live refreshes of the board and map.
REFRESH_SECONDS=30
